import time
import math
import random

def simulated_signal_level(freq_hz: float) -> float:
    """
    Demo 'measurement' function:
    Pretends there are signals near 1000 Hz and 2500 Hz + some noise.
    Replace this with real sensor/device reading if needed.
    """
    # Two fake peaks
    peak1 = math.exp(-((freq_hz - 1000.0) ** 2) / (2 * (80.0 ** 2)))
    peak2 = math.exp(-((freq_hz - 2500.0) ** 2) / (2 * (120.0 ** 2)))
    noise = random.uniform(0.0, 0.15)
    return 1.2 * peak1 + 1.0 * peak2 + noise

def scan_frequency(start_hz: float, stop_hz: float, step_hz: float, dwell_s: float = 0.05):
    """
    Sweeps frequency from start_hz to stop_hz in step_hz increments.
    At each frequency, it 'measures' a level and records results.
    """
    if step_hz <= 0:
        raise ValueError("step_hz must be > 0")
    if stop_hz < start_hz:
        raise ValueError("stop_hz must be >= start_hz")

    results = []
    f = start_hz

    print(f"Scanning {start_hz} Hz to {stop_hz} Hz in {step_hz} Hz steps...\n")

    while f <= stop_hz + 1e-9:
        level = simulated_signal_level(f)
        results.append((f, level))
        print(f"Freq: {f:10.2f} Hz  |  Level: {level:0.4f}")
        time.sleep(dwell_s)
        f += step_hz

    # Find strongest frequency
    best_freq, best_level = max(results, key=lambda x: x[1])

    print("\nDone.")
    print(f"Strongest detected at: {best_freq:.2f} Hz (level {best_level:.4f})")

    return results

if __name__ == "__main__":
    # Example run (edit these to match your assignment)
    start = float(input("Enter start frequency (Hz): "))
    stop  = float(input("Enter stop frequency (Hz): "))
    step  = float(input("Enter step (Hz): "))
    dwell = float(input("Enter dwell time per step (seconds): "))

    scan_frequency(start, stop, step, dwell)