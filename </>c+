const int SIGNAL_PIN = 27;
const unsigned long GATE_MS = 500;
volatile unsigned long pulseCount = 0;

void IRAM_ATTR onPulse() { pulseCount++; }

void setup() {
  Serial.begin(115200);
  pinMode(SIGNAL_PIN, INPUT);
  attachInterrupt(digitalPinToInterrupt(SIGNAL_PIN), onPulse, RISING);
}

void loop() {
  pulseCount = 0;
  unsigned long start = millis();
  while (millis() - start < GATE_MS) {}

  noInterrupts();
  unsigned long count = pulseCount;
  interrupts();

  float freqHz = count / (GATE_MS / 1000.0);
  Serial.printf("Pulses: %lu | Frequency: %.2f Hz\n", count, freqHz);
  delay(200);
}